---
// src/components/LanguageToggle.astro
---

<button id="lang-toggle" class="lang-btn" type="button" aria-label="Toggle language">
    <span class="lang-es">EN</span>
    <span class="lang-en">ES</span>
</button>

<style>
    .lang-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.25rem 0.55rem;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        border-radius: 6px;
        border: 1px solid var(--border-color-main, rgba(255, 255, 255, 0.2));
        background: transparent;
        color: var(--text-color-main, inherit);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .lang-btn:hover {
        background: var(--background-color-muted, rgba(255, 255, 255, 0.1));
        transform: translateY(-1px);
    }
</style>

<script is:inline>
    function applyLanguage(lang) {
        document.documentElement.setAttribute('lang', lang);
        localStorage.setItem('site_lang', lang);
    }

    function initLangToggle() {
        const savedLang = localStorage.getItem('site_lang') || 'es';
        applyLanguage(savedLang);

        const btn = document.getElementById('lang-toggle');
        if (btn) {
            btn.onclick = () => {
                const currentLang = document.documentElement.getAttribute('lang') || 'es';
                const nextLang = currentLang === 'es' ? 'en' : 'es';
                applyLanguage(nextLang);
            };
        }
    }

    // Se ejecuta en la carga inicial y cada vez que navegas a otra página
    document.addEventListener('astro:page-load', initLangToggle);
    initLangToggle();
</script>
