---
// src/components/VideoSection.astro
import T from './T.astro';

const videoId = 'uytZOO3yn1o';
const videoUrl = `https://youtu.be/${videoId}`;
const thumbnailUrl = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
---

<section class="w-full mb-14 sm:mb-20">
    <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl border border-theme-border/40 bg-gradient-to-br from-theme-bg-muted/60 via-theme-bg-muted/30 to-theme-bg-muted/10 p-6 sm:p-8 shadow-lg transition-all duration-300 hover:border-accent/40">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
            
            <!-- Textos explicativos y Botón -->
            <div class="md:col-span-7 flex flex-col gap-3 order-2 md:order-1">
                <div class="inline-flex items-center gap-2 self-start rounded-full border border-red-500/30 bg-red-500/10 px-3 py-1 text-xs font-semibold text-red-500">
                    <span class="inline-block w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                    <T es="Demostración en Video" en="Video Walkthrough" />
                </div>

                <h2 class="text-2xl font-serif font-medium sm:text-3xl leading-tight">
                    <T es="Simulador de Negocio" en="Business Simulator" />
                </h2>

                <p class="text-sm sm:text-base opacity-85 leading-relaxed text-pretty">
                    <T
                        es="Observá en acción cómo opera el simulador bimonetario con capacidad de aforo limitada, asignación de distribuciones aleatorias y proyección de flujos de fondos para la toma de decisiones estratégicas."
                        en="Watch a walkthrough of the dual-currency business simulator featuring capacity modeling, random distributions, and cash flow projections in action."
                    />
                </p>

                <div class="pt-2">
                    <a
                        href={videoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-h-11 items-center justify-center gap-2 px-6 py-2.5 rounded-full bg-red-600 hover:bg-red-700 text-white font-medium text-sm shadow-md shadow-red-600/20 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0"
                    >
                        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                            <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
                        </svg>
                        <span><T es="Ver Video en YouTube ↗" en="Watch on YouTube ↗" /></span>
                    </a>
                </div>
            </div>

            <!-- Miniatura con botón de Play clickeable hacia YouTube -->
            <div class="md:col-span-5 order-1 md:order-2">
                <a
                    href={videoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group relative block aspect-video w-full overflow-hidden rounded-xl sm:rounded-2xl border border-theme-border/40 shadow-md"
                    aria-label="Ver video en YouTube"
                >
                    <img
                        src={thumbnailUrl}
                        alt="Simulador Bimonetario de Negocio"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                    />
                    <!-- Overlay oscuro con botón de play estilizado -->
                    <div class="absolute inset-0 bg-black/30 group-hover:bg-black/15 transition-colors flex items-center justify-center">
                        <div class="w-14 h-14 rounded-full bg-red-600/90 text-white flex items-center justify-center shadow-xl shadow-black/40 group-hover:scale-110 group-hover:bg-red-600 transition-all duration-300">
                            <svg class="w-6 h-6 fill-current translate-x-0.5" viewBox="0 0 24 24">
                                <path d="M8 5v14l11-7z"/>
                            </svg>
                        </div>
                    </div>
                </a>
            </div>

        </div>
    </div>
</section>