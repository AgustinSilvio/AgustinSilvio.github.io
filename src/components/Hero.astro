---
// src/components/Hero.astro
import Button from './Button.astro';
import T from './T.astro';
---

<section class="w-full flex flex-col gap-6 mb-16 sm:mb-24">
    <h1 class="text-3xl font-serif font-medium sm:text-5xl leading-tight">
        <T es="Consultoría Actuarial & Análisis de Datos" en="Actuarial Consulting & Data Analytics" />
    </h1>

    <p class="text-lg leading-relaxed opacity-90">
        <T
            es="Actuario enfocado en el modelado cuantitativo de riesgos, tarificación, optimización de bases de datos relacionales y soluciones de Business Intelligence."
            en="Actuary focused on quantitative risk modeling, pricing, relational database architecture, and executive Business Intelligence solutions."
        />
    </p>

    <div class="flex flex-wrap gap-4 mt-2">
        <Button href="/about">
            <T es="Conocer más sobre mí →" en="Learn more about me →" />
        </Button>
    </div>
</section>
