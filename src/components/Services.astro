---
// src/components/Services.astro
import T from './T.astro';

const services = [
    {
        icon: '📊',
        title_es: 'Simuladores de Viabilidad & Retorno de Inversión',
        title_en: 'Viability Simulators & ROI Modeling',
        subtitle_es: 'PyMEs, Clínicas & Complejos Deportivos',
        subtitle_en: 'SMEs, Clinics & Sports Complexes',
        desc_es:
            'Modelos cuantitativos dinámicos de viabilidad económica, cálculo de punto de equilibrio y proyección de flujos de fondos mensuales. Permiten evaluar la rentabilidad real de un proyecto o ampliación antes de comprometer capital.',
        desc_en:
            'Dynamic quantitative models for economic viability, breakeven analysis, and monthly cash flow projections. Accurately assessing project profitability before committing capital.',
        tags: ['Viabilidad Económica', 'Punto de Equilibrio', 'Flujo de Fondos'],
        benefit_es: 'Certeza financiera y proyección de escenarios antes de invertir.',
        benefit_en: 'Financial certainty and scenario forecasting prior to investment.'
    },
    {
        icon: '⏱️',
        title_es: 'Modelado de Capacidad & Aforo',
        title_en: 'Capacity & Throughput Modeling',
        subtitle_es: 'Optimización de Turnos & Flujo Operativo',
        subtitle_en: 'Shift Optimization & Operational Flow',
        desc_es:
            'Análisis de aforo, teoría de colas y optimización de uso de recursos en guardias, consultorios, canchas y salas de tratamiento. Eliminación de cuellos de botella y esperas prolongadas para los usuarios.',
        desc_en:
            'Capacity modeling, queuing theory, and resource allocation for emergency rooms, clinics, sports facilities, and treatment rooms. Eliminating operational bottlenecks and client wait times.',
        tags: ['Aforo & Ocupación', 'Tiempos de Espera', 'Optimización'],
        benefit_es: 'Máxima ocupación y rendimiento de instalaciones sin saturar la atención.',
        benefit_en: 'Maximum facility utilization and efficiency without operational congestion.'
    },
    {
        icon: '🛡️',
        title_es: 'Análisis de Estrés Operativo & Riesgo',
        title_en: 'Operational Stress Testing & Risk',
        subtitle_es: 'Mitigación de Riesgos para Inversores',
        subtitle_en: 'Risk Mitigation for Investors',
        desc_es:
            'Pruebas de estrés ante caídas de demanda, variación de costos e inflación. Blindaje cuantitativo para fundamentar presentaciones ante inversores, comités de crédito y socios comerciales.',
        desc_en:
            'Stress testing under demand shocks, cost volatility, and inflation. Quantitative shielding to strengthen presentations for investors, credit committees, and partners.',
        tags: ['Stress Testing', 'Mitigación de Riesgos', 'Inversores'],
        benefit_es: 'Respaldo técnico riguroso que brinda solidez ante rondas de inversión.',
        benefit_en: 'Rigorous technical backing that builds investor confidence.'
    },
    {
        icon: '📈',
        title_es: 'Consultoría Actuarial & Tarificación (Pricing)',
        title_en: 'Actuarial Consulting & Pricing',
        subtitle_es: 'Contratos Contingentes & Reservas',
        subtitle_en: 'Contingent Contracts & Reserves',
        desc_es:
            'Diseño y valuación económico-financiera de carteras, contratos contingentes, estimación de reservas técnicas de siniestros (IBNR) y tarifas técnicas sustentables.',
        desc_en:
            'Financial and actuarial valuation of portfolios, contingent contracts, technical loss reserving (IBNR), and sustainable rate-making.',
        tags: ['Tarificación / Pricing', 'Reservas IBNR', 'Solvencia Técnica'],
        benefit_es: 'Protección de solvencia y márgenes operativos sostenibles.',
        benefit_en: 'Solvency protection and long-term operating margin stability.'
    },
    {
        icon: '💼',
        title_es: 'Tableros de Control & Monitoreo Ejecutivo',
        title_en: 'Executive Dashboards & Real-Time Monitoring',
        subtitle_es: 'Visualización Interactiva para Toma de Decisiones',
        subtitle_en: 'Interactive Decision-Making Dashboards',
        desc_es:
            'Diseño de tableros ejecutivos interactivos para el seguimiento en tiempo real de indicadores clave de facturación, aforo, volumen de clientes y cobranzas.',
        desc_en:
            'Design of interactive executive dashboards for real-time tracking of revenue, capacity utilization, volume, and collections indicators.',
        tags: ['Indicadores Clave (KPIs)', 'Tableros Web', 'Control Gerencial'],
        benefit_es: 'Visibilidad total e inmediata para anticiparse a desvíos operativos.',
        benefit_en: 'Full operational visibility to proactively address financial deviations.'
    },
    {
        icon: '⚙️',
        title_es: 'Estructuración & Auditoría de Datos de Gestión',
        title_en: 'Data Structuring & Management Auditing',
        subtitle_es: 'Modelos Confiables & Procesos Auditables',
        subtitle_en: 'Reliable Models & Auditable Workflows',
        desc_es:
            'Conversión de planillas de cálculo dispersas o frágiles en sistemas estructurados y centralizados, garantizando consistencia matemática y trazabilidad completa.',
        desc_en:
            'Conversion of fragmented, fragile spreadsheets into structured, central models, ensuring mathematical consistency and full auditability.',
        tags: ['Modelos Auditables', 'Procesos Confiables', 'Eficiencia'],
        benefit_es: 'Eliminación de errores operativos y escalabilidad de la gestión diaria.',
        benefit_en: 'Elimination of manual errors and seamless operational scalability.'
    }
];

const benefits = [
    {
        title_es: 'Modelos Financieros Dinámicos',
        title_en: 'Dynamic Financial Models',
        desc_es: 'Simulaciones a medida según la estructura operativa de tu PyME.',
        desc_en: 'Tailored simulations aligned with your operational business structure.'
    },
    {
        title_es: 'Mitigación de Riesgos',
        title_en: 'Risk Mitigation',
        desc_es: 'Respaldo cuantitativo para decisiones estratégicas y de inversión.',
        desc_en: 'Quantitative evidence for strategic and investment decisions.'
    },
    {
        title_es: 'Eficiencia Operativa',
        title_en: 'Operational Efficiency',
        desc_es: 'Optimización de aforo, turnos y monitoreo en tiempo real.',
        desc_en: 'Capacity and throughput optimization with real-time tracking.'
    }
];
---

<section id="servicios" class="services-section scroll-reveal">
    <div class="container">
        <div class="section-header">
            <span class="inline-block text-xs font-bold uppercase tracking-widest text-accent mb-2">
                <T es="Enfoque en Soluciones de Negocio" en="Business Solutions Focus" />
            </span>
            <h2 class="text-2xl sm:text-4xl font-serif font-medium">
                <T es="Servicios de Consultoría Cuantitativa" en="Quantitative Consulting Services" />
            </h2>
            <p class="text-sm sm:text-base opacity-85 max-w-2xl mx-auto mt-2 text-pretty">
                <T
                    es="Soluciones cuantitativas y simuladores orientados al impacto: viabilidad financiera, optimización de aforo operativo y fundamentación ante inversores."
                    en="Impact-driven quantitative solutions and simulators: financial viability, operational capacity optimization, and investor case-building."
                />
            </p>
        </div>

        <!-- Banner de Beneficios -->
        <div class="benefits-banner">
            {
                benefits.map((b) => (
                    <div class="benefit-item">
                        <span class="check-icon">✓</span>
                        <div>
                            <strong>
                                <T es={b.title_es} en={b.title_en} />:
                            </strong>{' '}
                            <T es={b.desc_es} en={b.desc_en} />
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- Grid de Tarjetas -->
        <div class="services-grid">
            {
                services.map((service) => (
                    <div class="service-card tarjeta-hover">
                        <div class="card-header">
                            <span class="service-icon">{service.icon}</span>
                            <div class="tags">
                                {service.tags.map((tag) => (
                                    <span class="tag">{tag}</span>
                                ))}
                            </div>
                        </div>

                        <h3>
                            <T es={service.title_es} en={service.title_en} />
                        </h3>
                        <span class="subtitle">
                            <T es={service.subtitle_es} en={service.subtitle_en} />
                        </span>
                        <p class="description">
                            <T es={service.desc_es} en={service.desc_en} />
                        </p>

                        <div class="card-footer">
                            <strong>
                                <T es="Impacto" en="Impact" />:
                            </strong>{' '}
                            <T es={service.benefit_es} en={service.benefit_en} />
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .services-section {
        padding: 2.5rem 0 3.5rem;
    }
    .container {
        max-width: 1100px;
        margin: 0 auto;
    }
    .section-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }
    .benefits-banner {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
        gap: 1rem;
        background: var(--bg-muted, rgba(255, 255, 255, 0.04));
        border: 1px solid var(--border-main, rgba(255, 255, 255, 0.08));
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 2.5rem;
    }
    .benefit-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        font-size: 0.92rem;
    }
    .check-icon {
        color: var(--accent-color, #2563eb);
        font-weight: bold;
    }
    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
        gap: 1.75rem;
    }
    .service-card {
        background: var(--bg-muted, rgba(255, 255, 255, 0.02));
        border: 1px solid var(--border-main, rgba(255, 255, 255, 0.08));
        border-radius: 18px;
        padding: 2rem 1.75rem;
        display: flex;
        flex-direction: column;
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, border-color 0.3s ease;
    }
    .service-card:hover {
        transform: translateY(-8px);
        border-color: var(--accent-color, #3b82f6);
        box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.15);
    }
    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
    }
    .service-icon {
        font-size: 2.2rem;
    }
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        justify-content: flex-end;
    }
    .tag {
        font-size: 0.72rem;
        background: rgba(125, 125, 125, 0.1);
        padding: 0.25rem 0.6rem;
        border-radius: 9999px;
        font-weight: 500;
        opacity: 0.85;
    }
    .service-card h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
        line-height: 1.3;
    }
    .subtitle {
        font-size: 0.85rem;
        opacity: 0.6;
        margin-bottom: 1rem;
        display: block;
        font-weight: 500;
    }
    .description {
        font-size: 0.95rem;
        line-height: 1.6;
        opacity: 0.85;
        margin-bottom: 1.5rem;
        flex-grow: 1;
    }
    .card-footer {
        border-top: 1px solid var(--border-main, rgba(255, 255, 255, 0.08));
        padding-top: 1rem;
        font-size: 0.85rem;
        opacity: 0.9;
    }
</style>