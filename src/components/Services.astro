---
// src/components/Services.astro
import T from './T.astro';

const services = [
    {
        icon: '📊',
        title_es: 'Simuladores de Negocio & Viabilidad Financiera',
        title_en: 'Business Simulators & Financial Viability',
        subtitle_es: 'PyMEs, Clínicas, Centros Deportivos, Centros de Salud, etc.',
        subtitle_en: 'SMEs, Clinics, Sports Complexes, Health Centers, etc.',
        desc_es:
            'Modelos dinámicos y simuladores cuantitativos de viabilidad económica, punto de equilibrio y proyección de flujos de caja (Cash Flow) para centros de salud, clínicas y complejos deportivos.',
        desc_en:
            'Dynamic models and quantitative simulators of economic viability, breakeven points, and cash flow projections for health centers, clinics, and sports facilities.',
        tags: ['Simuladores / Tools', 'Flujo de Fondos', 'Viabilidad PyME'],
        benefit_es: 'Proyección precisa de rentabilidad y retorno de inversión antes de comprometer capital.',
        benefit_en: 'Accurate projection of profitability and ROI before committing capital.'
    },
    {
        icon: '⏱️',
        title_es: 'Modelado de Capacidad & Aforo',
        title_en: 'Capacity & Throughput Modeling',
        subtitle_es: 'Optimización de Turnos & Flujo Operativo',
        subtitle_en: 'Shift Optimization & Operational Flow',
        desc_es:
            'Análisis de aforo, teoría de colas y optimización de uso de recursos en guardias, consultorios, canchas y salas de tratamiento. Eliminación de cuellos de botella.',
        desc_en:
            'Capacity analysis, queuing theory, and resource utilization optimization for emergency rooms, clinics, sports courts, and treatment rooms. Eliminating operational bottlenecks.',
        tags: ['Capacidad / Aforo', 'Optimización', 'Operaciones'],
        benefit_es: 'Máxima utilización de instalaciones sin saturación ni demoras para los clientes.',
        benefit_en: 'Maximum facility utilization without overcrowding or customer wait times.'
    },
    {
        icon: '🛡️',
        title_es: 'Análisis de Estrés Operativo & Riesgo',
        title_en: 'Operational Stress Testing & Risk',
        subtitle_es: 'Mitigación de Riesgos para Inversores',
        subtitle_en: 'Risk Mitigation for Investors',
        desc_es:
            'Pruebas de estrés ante escenarios adversos: caídas de demanda, variación de costos e inflación. Blindaje cuantitativo para comités de inversión y crédito.',
        desc_en:
            'Stress testing under adverse scenarios: demand shocks, cost fluctuations, and inflation. Quantitative shielding for investment and credit committees.',
        tags: ['Stress Testing', 'Mitigación de Riesgos', 'Inversores'],
        benefit_es: 'Respaldo técnico riguroso que genera certidumbre en socios e inversores.',
        benefit_en: 'Rigorous technical backing that generates certainty for partners and investors.'
    },
    {
        icon: '📈',
        title_es: 'Consultoría Actuarial & Tarificación (Pricing)',
        title_en: 'Actuarial Consulting & Pricing',
        subtitle_es: 'Contratos Contingentes & Reservas',
        subtitle_en: 'Contingent Contracts & Reserves',
        desc_es:
            'Diseño y valuación económico-financiera de carteras, contratos contingentes, estimación de reservas de siniestros (IBNR) y tarificación técnica sustentable.',
        desc_en: 'Design and financial valuation of portfolios, contingent contracts, loss reserving (IBNR), and sustainable technical pricing.',
        tags: ['Pricing / Tarificación', 'Reservas IBNR', 'Seguros'],
        benefit_es: 'Protección de solvencia técnica y márgenes operativos sostenibles.',
        benefit_en: 'Protection of technical solvency and sustainable operating margins.'
    },
    {
        icon: '💼',
        title_es: 'Business Intelligence & Tableros de Control',
        title_en: 'Business Intelligence & Dashboards',
        subtitle_es: 'Monitoreo Ejecutivo en Tiempo Real',
        subtitle_en: 'Real-Time Executive Monitoring',
        desc_es:
            'Diseño de paneles interactivos de control gerencial automatizados para el seguimiento en tiempo real de indicadores de volumen, cobranzas y siniestralidad.',
        desc_en: 'Design of automated executive dashboards for real-time monitoring of volume, collections, and loss ratio indicators.',
        tags: ['KPIs / Métricas', 'Dashboards', 'BI Ejecutivo'],
        benefit_es: 'Visibilidad total del negocio para toma de decisiones rápida e informada.',
        benefit_en: 'Total business visibility for fast, data-backed strategic decisions.'
    },
    {
        icon: '⚙️',
        title_es: 'Automatización & Arquitectura de Datos',
        title_en: 'Process Automation & Data Architecture',
        subtitle_es: 'Pipelines & Bases Relacionales',
        subtitle_en: 'Pipelines & Relational Databases',
        desc_es:
            'Migración y ordenamiento de planillas de cálculo dispersas a sistemas estructurados sobre bases de datos relacionales, reduciendo tiempos manuales.',
        desc_en: 'Migration and restructuring of fragmented spreadsheets into auditable relational database workflows, drastically cutting manual overhead.',
        tags: ['ETL / Automatización', 'Bases de Datos', 'Eficiencia'],
        benefit_es: 'Eliminación de errores operativos y escalabilidad de los flujos de trabajo.',
        benefit_en: 'Elimination of manual errors and seamless scalability of workflows.'
    }
];

const benefits = [
    {
        title_es: 'Modelos Financieros Dinámicos',
        title_en: 'Dynamic Financial Models',
        desc_es: 'Simulaciones precisas adaptadas a la realidad de tu PyME.',
        desc_en: 'Accurate simulations tailored to your SME reality.'
    },
    {
        title_es: 'Mitigación de Riesgos',
        title_en: 'Risk Mitigation',
        desc_es: 'Respaldo cuantitativo para decisiones de inversión y crédito.',
        desc_en: 'Quantitative backing for investment and credit decisions.'
    },
    {
        title_es: 'Eficiencia de Procesos',
        title_en: 'Process Efficiency',
        desc_es: 'Optimización de aforo, turnos y automatización de reportes.',
        desc_en: 'Throughput optimization, scheduling, and automated reporting.'
    },
    {
        title_es: 'Capacitaciones',
        title_en: 'Training & Workshops',
        desc_es: 'Capacitaciones personalizadas para tu equipo en análisis de datos, pensamiento crítico de negocio y administración financiera.',
        desc_en: 'Customized training for your team in data analysis, critical business thinking, and financial management.'
    }
];
---

<section id="servicios" class="services-section">
    <div class="container">
        <div class="section-header">
            <span class="inline-block text-xs font-bold uppercase tracking-widest text-accent mb-2">
                <T es="Servicios personalizados" en="Tailored Services" />
            </span>
            <h2>
                <T es="Servicios para PyMEs" en="Services for SMEs" />
            </h2>
            <p>
                <T
                    es="Soluciones cuantitativas y simuladores a medida para evaluar viabilidad financiera, optimizar aforo operativo y presentar proyectos sólidos a inversores."
                    en="Quantitative solutions and bespoke simulators to assess financial viability, optimize operational capacity, and present solid cases to investors."
                />
            </p>
        </div>

        <!-- Banner de Beneficios -->
        <div class="benefits-banner">
            {
                benefits.map((b) => (
                    <div class="benefit-item">
                        <span class="check-icon">✓</span>
                        <div>
                            <strong>
                                <T es={b.title_es} en={b.title_en} />:
                            </strong>{' '}
                            <T es={b.desc_es} en={b.desc_en} />
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- Grid de Tarjetas -->
        <div class="services-grid">
            {
                services.map((service) => (
                    <div class="service-card tarjeta-hover">
                        <div class="card-header">
                            <span class="service-icon">{service.icon}</span>
                            <div class="tags">
                                {service.tags.map((tag) => (
                                    <span class="tag">{tag}</span>
                                ))}
                            </div>
                        </div>

                        <h3>
                            <T es={service.title_es} en={service.title_en} />
                        </h3>
                        <span class="subtitle">
                            <T es={service.subtitle_es} en={service.subtitle_en} />
                        </span>
                        <p class="description">
                            <T es={service.desc_es} en={service.desc_en} />
                        </p>

                        <div class="card-footer">
                            <strong>
                                <T es="Impacto" en="Impact" />:
                            </strong>{' '}
                            <T es={service.benefit_es} en={service.benefit_en} />
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .services-section {
        padding: 3rem 0;
    }
    .container {
        max-width: 1100px;
        margin: 0 auto;
    }
    .section-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }
    .section-header h2 {
        font-size: 2.25rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
    }
    .section-header p {
        opacity: 0.85;
        font-size: 1.05rem;
        max-width: 700px;
        margin: 0 auto;
        line-height: 1.6;
    }
    .benefits-banner {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
        gap: 1rem;
        background: var(--bg-muted, rgba(255, 255, 255, 0.04));
        border: 1px solid var(--border-main, rgba(255, 255, 255, 0.08));
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 2.5rem;
    }
    .benefit-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        font-size: 0.92rem;
    }
    .check-icon {
        color: var(--accent-color, #2563eb);
        font-weight: bold;
    }
    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
        gap: 1.75rem;
    }
    .service-card {
        background: var(--bg-muted, rgba(255, 255, 255, 0.02));
        border: 1px solid var(--border-main, rgba(255, 255, 255, 0.08));
        border-radius: 18px;
        padding: 2rem 1.75rem;
        display: flex;
        flex-direction: column;
        transition:
            transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
            box-shadow 0.35s ease,
            border-color 0.3s ease;
    }
    .service-card:hover {
        transform: translateY(-8px);
        border-color: var(--accent-color, #3b82f6);
        box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.15);
    }
    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
    }
    .service-icon {
        font-size: 2.2rem;
    }
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        justify-content: flex-end;
    }
    .tag {
        font-size: 0.72rem;
        background: rgba(125, 125, 125, 0.1);
        padding: 0.25rem 0.6rem;
        border-radius: 9999px;
        font-weight: 500;
        opacity: 0.85;
    }
    .service-card h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
        line-height: 1.3;
    }
    .subtitle {
        font-size: 0.85rem;
        opacity: 0.6;
        margin-bottom: 1rem;
        display: block;
        font-weight: 500;
    }
    .description {
        font-size: 0.95rem;
        line-height: 1.6;
        opacity: 0.85;
        margin-bottom: 1.5rem;
        flex-grow: 1;
    }
    .card-footer {
        border-top: 1px solid var(--border-main, rgba(255, 255, 255, 0.08));
        padding-top: 1rem;
        font-size: 0.85rem;
        opacity: 0.9;
    }
</style>
