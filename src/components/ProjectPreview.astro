---
// src/components/ProjectPreview.astro
import type { HTMLTag, Polymorphic } from 'astro/types';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import T from './T.astro';

type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{ as: Tag }> & {
    project: CollectionEntry<'projects'>;
    headingLevel?: 'h2' | 'h3';
};

const { project, as: Tag = 'div', headingLevel = 'h2', class: className, ...props } = Astro.props;
const HeadingTag = headingLevel;

// Lectura de campos con soporte bilingüe
const data = project.data as Record<string, any>;
const title_es = (data.title_es as string) || data.title;
const title_en = (data.title_en as string) || data.title;
const desc_es = (data.description_es as string) || data.description || '';
const desc_en = (data.description_en as string) || data.description || '';
---

<Tag class:list={['group', className]} {...props}>
    <a class="flex flex-col gap-1.5" href={`/projects/${project.id}/`}>
        <div class="flex items-baseline justify-between gap-4">
            <HeadingTag class="text-lg font-serif font-medium group-hover:underline group-hover:underline-offset-2">
                <T es={title_es} en={title_en} />
            </HeadingTag>
            <span class="text-xs opacity-60 shrink-0">
                <FormattedDate date={project.data.publishDate} />
            </span>
        </div>
        {
            (desc_es || desc_en) && (
                <p class="text-sm opacity-80 line-clamp-2 leading-relaxed">
                    <T es={desc_es} en={desc_en} />
                </p>
            )
        }
    </a>
</Tag>
